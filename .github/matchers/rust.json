{
  "problemMatcher": [
    {
      "owner": "rustc",
      "pattern": [
        {
          "regexp": "^(warning|error)(?:\\[(\\S+)\\])?: (.*)$",
          "severity": 1,
          "code": 2,
          "message": 3
        },
        {
          "regexp": "^\\s*--> (\\S+):(\\d+):(\\d+)$",
          "file": 1,
          "line": 2,
          "column": 3
        }
      ]
    },
    {
      "owner": "rust-test-panic",
      "pattern": [
        {
          "regexp": "^thread '([^']+)'(?: \\(\\d+\\))? panicked at (\\S+?):(\\d+):(\\d+):$",
          "code": 1,
          "file": 2,
          "line": 3,
          "column": 4
        },
        {
          "regexp": "^(.+)$",
          "message": 1
        }
      ]
    },
    {
      "owner": "rustfmt",
      "pattern": [
        {
          "regexp": "^(Diff in (\\S+?):(\\d+):)$",
          "message": 1,
          "file": 2,
          "line": 3
        }
      ]
    }
  ]
}
